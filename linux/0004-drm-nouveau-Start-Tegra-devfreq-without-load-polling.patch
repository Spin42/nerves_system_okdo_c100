From: Marc Lainez <marc.lainez@gmail.com>
Subject: [PATCH] drm/nouveau: Start Tegra devfreq without load polling

devfreq is registered from clk init with simple_ondemand, whose 50 ms
load polling reads and resets the PMU idle counters through a raw MMIO
mapping, and init itself programs those counters. Both happen while
nouveau is still booting the PMU and initialising GR, and on a Jetson
Nano that init then times out in about a quarter of the boots
("pmu:hpq: timeout waiting for reply", "gr: init failed").

Register with the userspace governor, which keeps the boot clock and does
not poll, and set the counters up on the first load sample. A load-based
governor can be selected through sysfs once the GPU is up.

---
--- a/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gk20a_devfreq.c
+++ b/drivers/gpu/drm/nouveau/nvkm/subdev/clk/gk20a_devfreq.c
@@ -70,6 +70,9 @@
 
 	/** @time_last_update: Last update time. */
 	ktime_t time_last_update;
+
+	/** @counters_ready: PMU idle counters are configured. */
+	bool counters_ready;
 };
 
 static struct gk20a_devfreq *dev_to_gk20a_devfreq(struct device *dev)
@@ -235,6 +238,16 @@
 
 	gk20a_devfreq_get_cur_freq(dev, &status->current_frequency);
 
+	/*
+	 * The counters are set up on first use rather than at init: init runs
+	 * before nouveau has booted the PMU, whose reset clears them.
+	 */
+	if (!gdevfreq->counters_ready) {
+		gk20a_pmu_init_perfmon_counter(gdevfreq);
+		gk20a_devfreq_reset(gdevfreq);
+		gdevfreq->counters_ready = true;
+	}
+
 	gk20a_devfreq_update_utilization(gdevfreq);
 
 	status->busy_time = ktime_to_ns(gdevfreq->busy_time);
@@ -278,19 +291,23 @@
 		dev_pm_opp_add(base->subdev.device->dev,
 			       pstates[i].base.domain[nv_clk_src_gpc] * GK20A_CLK_GPC_MDIV, 0);
 
-	gk20a_pmu_init_perfmon_counter(new_gdevfreq);
-	gk20a_devfreq_reset(new_gdevfreq);
-
 	gk20a_devfreq_profile.initial_freq =
 		nvkm_clk_read(base, nv_clk_src_gpc) * GK20A_CLK_GPC_MDIV;
 
 	new_gdevfreq->gov_data.upthreshold = 45;
 	new_gdevfreq->gov_data.downdifferential = 5;
 
+	/*
+	 * Load polling reads and resets the PMU idle counters every 50 ms
+	 * with no regard for the PMU's state. Running while nouveau boots the
+	 * PMU and initialises GR, it makes that init time out. Start with the
+	 * userspace governor, which keeps the boot clock and does not touch
+	 * the PMU; simple_ondemand can be selected once the GPU is up.
+	 */
 	new_gdevfreq->devfreq = devm_devfreq_add_device(device->dev,
 							&gk20a_devfreq_profile,
-							DEVFREQ_GOV_SIMPLE_ONDEMAND,
-							&new_gdevfreq->gov_data);
+							DEVFREQ_GOV_USERSPACE,
+							NULL);
 	if (IS_ERR(new_gdevfreq->devfreq))
 		return PTR_ERR(new_gdevfreq->devfreq);
 
