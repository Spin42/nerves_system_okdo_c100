// SPDX-License-Identifier: GPL-2.0
/*
 * OKdo Nano C100: Jetson Nano production module (P3448-0002, 16 GB eMMC) on
 * a carrier derived from the P3449 B01 developer kit carrier.
 *
 * Differences from the developer kit (tegra210-p3450-0000.dts):
 * - the module has eMMC on SDMMC4 and nothing on SDMMC1;
 * - the carrier's microSD slot is wired to SDMMC3 (the developer kit uses
 *   SDMMC3 for SDIO on the M.2 key E slot). The slot has no card-detect line
 *   and runs at 3.3 V signalling only, with its I/O rail on PMIC LDO6.
 */

/dts-v1/;

#include "nvidia/tegra210-p3450-0000.dts"

/ {
	model = "OKdo Nano C100";
	compatible = "okdo,c100", "nvidia,p3449-0000-b00+p3448-0002-b00",
		     "nvidia,p3450-0000", "nvidia,tegra210";

	/* eMMC first so that the Nerves root device is always mmcblk0 */
	aliases {
		mmc0 = "/mmc@700b0600";
		mmc1 = "/mmc@700b0400";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		/*
		 * cboot trains the DRAM at every boot and leaves the resulting
		 * timing tables (204 and 1600 MHz) at these fixed addresses.
		 */
		emc_table_nominal: emc-table@83400000 {
			compatible = "nvidia,tegra210-emc-table";
			reg = <0x0 0x83400000 0x0 0x10000>;
		};

		emc_table_derated: emc-table@83410000 {
			compatible = "nvidia,tegra210-emc-table";
			reg = <0x0 0x83410000 0x0 0x10000>;
		};
	};

	/*
	 * The two camera connectors (CAM0 on CSI port A, CAM1 on CSI port E,
	 * two lanes each) share the VI I2C bus through a GPIO-switched mux.
	 * They are described for Raspberry Pi Camera Module 3 (IMX708), which
	 * carries its own 24 MHz oscillator and regulators.
	 */
	cam_clk: clock-camera {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
	};

	/*
	 * Each connector's enable line powers the camera module's regulators;
	 * the sensor needs them settled before it answers on I2C.
	 */
	cam0_reg: regulator-cam0 {
		compatible = "regulator-fixed";
		regulator-name = "cam0";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&gpio TEGRA_GPIO(S, 7) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <70000>;
		off-on-delay-us = <30000>;
	};

	cam1_reg: regulator-cam1 {
		compatible = "regulator-fixed";
		regulator-name = "cam1";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&gpio TEGRA_GPIO(T, 0) GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <70000>;
		off-on-delay-us = <30000>;
	};

	i2c-mux-camera {
		compatible = "i2c-mux-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-parent = <&vi_i2c>;
		mux-gpios = <&gpio TEGRA_GPIO(I, 0) GPIO_ACTIVE_HIGH>;

		i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			camera@1a {
				compatible = "sony,imx708";
				reg = <0x1a>;
				clocks = <&cam_clk>;
				clock-names = "inclk";
				vana1-supply = <&cam0_reg>;

				port {
					cam0_out: endpoint {
						remote-endpoint = <&csi_a_in>;
						data-lanes = <1 2>;
						clock-noncontinuous;
						link-frequencies = /bits/ 64 <450000000>;
					};
				};
			};
		};

		i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			camera@1a {
				compatible = "sony,imx708";
				reg = <0x1a>;
				clocks = <&cam_clk>;
				clock-names = "inclk";
				vana1-supply = <&cam1_reg>;

				port {
					cam1_out: endpoint {
						remote-endpoint = <&csi_e_in>;
						data-lanes = <1 2>;
						clock-noncontinuous;
						link-frequencies = /bits/ 64 <450000000>;
					};
				};
			};
		};
	};

	host1x@50000000 {
		vi@54080000 {
			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					vi_a_in: endpoint {
						remote-endpoint = <&csi_a_out>;
					};
				};

				port@4 {
					reg = <4>;

					vi_e_in: endpoint {
						remote-endpoint = <&csi_e_out>;
					};
				};
			};

			csi@838 {
				#address-cells = <1>;
				#size-cells = <0>;

				/*
				 * The test pattern generator's clock comes from PLL_D,
				 * which also clocks the display controller driving DP:
				 * setting its rate would change the display's pixel
				 * clock. Only the lane clocks are set.
				 */
				assigned-clocks = <&tegra_car TEGRA210_CLK_CILAB>,
						  <&tegra_car TEGRA210_CLK_CILCD>,
						  <&tegra_car TEGRA210_CLK_CILE>;
				assigned-clock-parents = <&tegra_car TEGRA210_CLK_PLL_P>,
							 <&tegra_car TEGRA210_CLK_PLL_P>,
							 <&tegra_car TEGRA210_CLK_PLL_P>;
				assigned-clock-rates = <102000000>,
						       <102000000>,
						       <102000000>;

				channel@0 {
					reg = <0>;
					nvidia,mipi-calibrate = <&mipi 0x01>; /* CSIA pad */
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;

						csi_a_in: endpoint {
							data-lanes = <1 2>;
							remote-endpoint = <&cam0_out>;
						};
					};

					port@1 {
						reg = <1>;

						csi_a_out: endpoint {
							remote-endpoint = <&vi_a_in>;
						};
					};
				};

				channel@4 {
					reg = <4>;
					nvidia,mipi-calibrate = <&mipi 0x10>; /* CSIE pad */
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;

						csi_e_in: endpoint {
							data-lanes = <1 2>;
							remote-endpoint = <&cam1_out>;
						};
					};

					port@1 {
						reg = <1>;

						csi_e_out: endpoint {
							remote-endpoint = <&vi_e_in>;
						};
					};
				};
			};
		};

		vi_i2c: i2c@546c0000 {
			power-sensor@40 {
				compatible = "ti,ina3221";
				reg = <0x40>;
				#address-cells = <1>;
				#size-cells = <0>;

				input@0 {
					reg = <0x0>;
					label = "POM_5V_IN";
					shunt-resistor-micro-ohms = <5000>;
				};

				input@1 {
					reg = <0x1>;
					label = "POM_5V_GPU";
					shunt-resistor-micro-ohms = <5000>;
				};

				input@2 {
					reg = <0x2>;
					label = "POM_5V_CPU";
					shunt-resistor-micro-ohms = <5000>;
				};
			};
		};
	};

	external-memory-controller@7001b000 {
		memory-region = <&emc_table_nominal>, <&emc_table_derated>;
		memory-region-names = "nominal", "derated";
	};

	/*
	 * The GPU stops at 921.6 MHz, the module's validated maximum. The
	 * mainline pstate table goes to 998.4 MHz, which needs about 1100 mV,
	 * above the 1068 mV nominal maximum.
	 *
	 * Nothing scales the EMC on demand, so the GPU, its main bandwidth user,
	 * requests the 1600 MHz rate cboot trains at every boot when it probes;
	 * at the 204 MHz boot rate memory bandwidth is about 4x lower.
	 */
	gpu@57000000 {
		operating-points-v2 = <&gpu_opp_table>;
		assigned-clocks = <&tegra_car TEGRA210_CLK_EMC>;
		assigned-clock-rates = <1600000000>;
	};

	gpu_opp_table: opp-table-gpu {
		compatible = "operating-points-v2";

		opp-76800000 {
			opp-hz = /bits/ 64 <76800000>;
		};

		opp-153600000 {
			opp-hz = /bits/ 64 <153600000>;
		};

		opp-230400000 {
			opp-hz = /bits/ 64 <230400000>;
		};

		opp-307200000 {
			opp-hz = /bits/ 64 <307200000>;
		};

		opp-384000000 {
			opp-hz = /bits/ 64 <384000000>;
		};

		opp-460800000 {
			opp-hz = /bits/ 64 <460800000>;
		};

		opp-537600000 {
			opp-hz = /bits/ 64 <537600000>;
		};

		opp-614400000 {
			opp-hz = /bits/ 64 <614400000>;
		};

		opp-691200000 {
			opp-hz = /bits/ 64 <691200000>;
		};

		opp-768000000 {
			opp-hz = /bits/ 64 <768000000>;
		};

		opp-844800000 {
			opp-hz = /bits/ 64 <844800000>;
		};

		opp-921600000 {
			opp-hz = /bits/ 64 <921600000>;
		};
	};

	/*
	 * The CPU stops at 1479 MHz, the module's validated maximum; the
	 * speedo table allows 1555.5 MHz.
	 */
	clock@70110000 {
		nvidia,dfll-max-freq-khz = <1479000>;
	};

	thermal-sensor@700e2000 {
		/* Over-current inputs as L4T configures them; both are active low */
		throttle-cfgs {
			oc1 {
				nvidia,priority = <50>;
				nvidia,cpu-throt-percent = <75>;
				nvidia,gpu-throt-level = <TEGRA_SOCTHERM_THROT_LEVEL_HIGH>;
				nvidia,count-threshold = <1>;
				nvidia,alarm-filter = <5100000>;
				nvidia,polarity-active-low;
			};

			oc3 {
				nvidia,priority = <40>;
				nvidia,cpu-throt-percent = <75>;
				nvidia,gpu-throt-level = <TEGRA_SOCTHERM_THROT_LEVEL_MED>;
				nvidia,count-threshold = <15>;
				nvidia,alarm-filter = <5100000>;
				nvidia,polarity-active-low;
			};
		};
	};

	/* L4T drives these high on this board; mainline does not use them */
	gpio@6000d000 {
		l4t-default-high-px3-hog {
			gpio-hog;
			gpios = <TEGRA_GPIO(X, 3) GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "l4t-default-high";
		};

		l4t-default-high-pcc7-hog {
			gpio-hog;
			gpios = <TEGRA_GPIO(CC, 7) GPIO_ACTIVE_HIGH>;
			output-high;
			line-name = "l4t-default-high";
		};
	};

	i2c@7000d000 {
		pmic@3c {
			/*
			 * L4T configures PMIC GPIO1 as an open-drain output and
			 * keeps it high instead of using it as an FPS output.
			 */
			pinmux {
				gpio1 {
					function = "gpio";
					/delete-property/ drive-push-pull;
					drive-open-drain = <1>;
				};
			};

			l4t-default-high-gpio1-hog {
				gpio-hog;
				gpios = <1 GPIO_ACTIVE_HIGH>;
				output-high;
				line-name = "l4t-default-high";
			};

			regulators {
				vddio_sdmmc3: ldo6 {
					regulator-name = "VDDIO_SDMMC3";
					regulator-min-microvolt = <3300000>;
					regulator-max-microvolt = <3300000>;
					regulator-enable-ramp-delay = <24>;
					regulator-ramp-delay = <100000>;
					regulator-always-on;
					regulator-boot-on;
					status = "okay";
				};
			};
		};
	};

	mmc@700b0000 {
		status = "disabled";
	};

	/* microSD */
	mmc@700b0400 {
		/delete-property/ non-removable;
		/delete-property/ cap-sdio-irq;
		/delete-property/ keep-power-in-suspend;
		/delete-property/ wakeup-source;

		status = "okay";
		bus-width = <4>;
		broken-cd;
		disable-wp;
		/*
		 * UHS needs a 1.8 V switch that the boot ROM and U-Boot cannot
		 * undo after a warm reset, which leaves the card unreadable.
		 */
		no-1-8-v;

		vqmmc-supply = <&vddio_sdmmc3>;
		vmmc-supply = <&vdd_3v3_sd>;
	};

	/* L4T keeps the USB hub powered */
	regulator-vdd-hub-3v3 {
		regulator-always-on;
		regulator-boot-on;
	};

	/* The P3448-0002 module has no QSPI flash */
	spi@70410000 {
		status = "disabled";
	};

	/* eMMC */
	mmc@700b0600 {
		status = "okay";
		bus-width = <8>;
		non-removable;
		vqmmc-supply = <&vdd_1v8>;
		vmmc-supply = <&vdd_3v3_sys>;
	};
};
