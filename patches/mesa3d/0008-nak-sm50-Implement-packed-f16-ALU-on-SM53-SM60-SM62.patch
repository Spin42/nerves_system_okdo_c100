diff --git a/src/nouveau/compiler/nak_private.h b/src/nouveau/compiler/nak_private.h
--- a/src/nouveau/compiler/nak_private.h
+++ b/src/nouveau/compiler/nak_private.h
@@ -24,6 +24,15 @@
    struct nir_shader_compiler_options nir_options;
 };
 
+/* Packed f16 add, multiply, fma and compare.  SM53 (GM20B), SM60 (GP100)
+ * and SM62 (GP10B) run them at twice the f32 rate, SM61 at 1/64th.
+ */
+static inline bool
+nak_has_f16v2_alu(const struct nak_compiler *nak)
+{
+   return nak->sm >= 70 || nak->sm == 53 || nak->sm == 60 || nak->sm == 62;
+}
+
 enum ENUM_PACKED nak_attr {
    /* System values A */
    NAK_ATTR_TESS_LOD_LEFT     = 0x000,
