From: Marc Lainez <marc.lainez@gmail.com>
Date: Tue, 20 Oct 2026 22:30:00 +0200
Subject: [PATCH] nak: Pair scalar f16 ALU into packed ops on SM53, SM60 and SM62

Combine independent scalar 16-bit fadd, fmul and ffma of a block into one
2-wide op, and turn loop-header phis carried in the two lanes of one result
into a vec2 phi.  vkpeak fp16-scalar on GM20B goes from 177 to 302
GFLOPS.

Assisted-by: Claude:claude-opus-5-5
---
diff --git a/src/nouveau/compiler/nak_nir.c b/src/nouveau/compiler/nak_nir.c
--- a/src/nouveau/compiler/nak_nir.c
+++ b/src/nouveau/compiler/nak_nir.c
@@ -1176,6 +1176,210 @@
    }
 }
 
+/* Packed f16 ALU runs two lanes for the price of one.  Pair independent
+ * scalar 16-bit fadd/fmul/ffma of a block into one 2-wide op, then turn
+ * loop-header phis carried in the two lanes of one result into a vec2 phi
+ * so the loop does not pack and unpack them on every iteration.
+ */
+static bool
+f16_pair_candidate(const nir_alu_instr *alu)
+{
+   switch (alu->op) {
+   case nir_op_fadd:
+   case nir_op_fmul:
+   case nir_op_ffma:
+      return alu->def.bit_size == 16 && alu->def.num_components == 1;
+   default:
+      return false;
+   }
+}
+
+/* Whether nothing in the block of "instr" reads "def" up to "instr" */
+static bool
+def_unused_until(nir_def *def, nir_instr *instr)
+{
+   nir_foreach_use_including_if(src, def) {
+      if (nir_src_is_if(src))
+         return false;
+
+      nir_instr *use = nir_src_parent_instr(src);
+      if (use->type == nir_instr_type_phi || use->block != instr->block)
+         continue;
+
+      if (use->index <= instr->index)
+         return false;
+   }
+   return true;
+}
+
+static bool
+pair_f16_alu_block(nir_builder *b, nir_block *block)
+{
+   bool progress = false;
+   nir_alu_instr *pending[8];
+   unsigned num_pending = 0;
+
+   nir_foreach_instr_safe(instr, block) {
+      if (instr->type != nir_instr_type_alu)
+         continue;
+
+      nir_alu_instr *alu = nir_instr_as_alu(instr);
+      if (!f16_pair_candidate(alu))
+         continue;
+
+      int match = -1;
+      for (int i = num_pending - 1; i >= 0; i--) {
+         nir_alu_instr *other = pending[i];
+         if (other->op == alu->op &&
+             other->fp_math_ctrl == alu->fp_math_ctrl &&
+             def_unused_until(&other->def, instr)) {
+            match = i;
+            break;
+         }
+      }
+
+      if (match < 0) {
+         if (num_pending == ARRAY_SIZE(pending)) {
+            memmove(pending, pending + 1, sizeof(pending[0]) * --num_pending);
+         }
+         pending[num_pending++] = alu;
+         continue;
+      }
+
+      nir_alu_instr *first = pending[match];
+      memmove(pending + match, pending + match + 1,
+              sizeof(pending[0]) * (num_pending - match - 1));
+      num_pending--;
+
+      b->cursor = nir_before_instr(instr);
+      nir_def *srcs[3] = { NULL, NULL, NULL };
+      for (unsigned s = 0; s < nir_op_infos[alu->op].num_inputs; s++) {
+         srcs[s] = nir_vec2(b,
+                            nir_channel(b, first->src[s].src.ssa,
+                                        first->src[s].swizzle[0]),
+                            nir_channel(b, alu->src[s].src.ssa,
+                                        alu->src[s].swizzle[0]));
+      }
+      nir_def *vec = nir_build_alu(b, alu->op, srcs[0], srcs[1], srcs[2], NULL);
+      nir_instr_as_alu(nir_def_instr(vec))->fp_math_ctrl = alu->fp_math_ctrl;
+
+      nir_def_rewrite_uses(&first->def, nir_channel(b, vec, 0));
+      nir_def_rewrite_uses(&alu->def, nir_channel(b, vec, 1));
+      nir_instr_remove(&first->instr);
+      nir_instr_remove(instr);
+
+      /* def_unused_until() compares instruction indices */
+      nir_index_instrs(b->impl);
+      progress = true;
+   }
+
+   return progress;
+}
+
+/* Whether "src" is component "comp" of a 2-component def, through movs */
+static bool
+phi_src_is_vec2_comp(nir_def *src, nir_def **vec, unsigned comp)
+{
+   nir_scalar s = nir_scalar_chase_movs(nir_get_scalar(src, 0));
+   if (s.def->num_components != 2 || s.comp != comp)
+      return false;
+
+   if (*vec == NULL)
+      *vec = s.def;
+   return *vec == s.def;
+}
+
+static bool
+pair_f16_loop_phis(nir_builder *b, nir_loop *loop)
+{
+   nir_block *header = nir_loop_first_block(loop);
+   bool progress = false;
+
+   nir_foreach_phi_safe(phi0, header) {
+      if (phi0->def.bit_size != 16 || phi0->def.num_components != 1)
+         continue;
+
+      nir_foreach_phi_safe(phi1, header) {
+         if (phi1 == phi0 || phi1->def.bit_size != 16 ||
+             phi1->def.num_components != 1)
+            continue;
+
+         /* The back-edge values must be the two lanes of one def */
+         bool ok = true;
+         nir_def *vec = NULL;
+         nir_foreach_phi_src(src0, phi0) {
+            if (src0->pred->index < header->index)
+               continue;
+            nir_phi_src *src1 = nir_phi_get_src_from_block(phi1, src0->pred);
+            if (!phi_src_is_vec2_comp(src0->src.ssa, &vec, 0) ||
+                !phi_src_is_vec2_comp(src1->src.ssa, &vec, 1))
+               ok = false;
+         }
+         if (!ok || vec == NULL)
+            continue;
+
+         nir_phi_instr *phi = nir_phi_instr_create(b->shader);
+         nir_def_init(&phi->instr, &phi->def, 2, 16);
+         nir_foreach_phi_src(src0, phi0) {
+            nir_phi_src *src1 = nir_phi_get_src_from_block(phi1, src0->pred);
+            nir_def *v;
+            if (src0->pred->index < header->index) {
+               b->cursor = nir_after_block_before_jump(src0->pred);
+               v = nir_vec2(b, src0->src.ssa, src1->src.ssa);
+            } else {
+               v = vec;
+            }
+            nir_phi_instr_add_src(phi, src0->pred, v);
+         }
+         nir_instr_insert(nir_before_block(header), &phi->instr);
+
+         b->cursor = nir_after_phis(header);
+         nir_def_rewrite_uses(&phi0->def, nir_channel(b, &phi->def, 0));
+         nir_def_rewrite_uses(&phi1->def, nir_channel(b, &phi->def, 1));
+         nir_instr_remove(&phi0->instr);
+         nir_instr_remove(&phi1->instr);
+         return true;
+      }
+   }
+
+   return progress;
+}
+
+static bool
+nak_nir_pair_f16_alu(nir_shader *nir)
+{
+   bool progress = false;
+
+   nir_foreach_function_impl(impl, nir) {
+      nir_builder b = nir_builder_create(impl);
+      bool impl_progress = false;
+
+      nir_index_instrs(impl);
+      nir_foreach_block(block, impl)
+         impl_progress |= pair_f16_alu_block(&b, block);
+
+      if (impl_progress) {
+         nir_metadata_require(impl, nir_metadata_block_index);
+         bool phi_progress;
+         do {
+            phi_progress = false;
+            nir_foreach_block(block, impl) {
+               nir_cf_node *parent = block->cf_node.parent;
+               if (parent->type == nir_cf_node_loop &&
+                   block == nir_loop_first_block(nir_cf_node_as_loop(parent)))
+                  phi_progress |=
+                     pair_f16_loop_phis(&b, nir_cf_node_as_loop(parent));
+            }
+         } while (phi_progress);
+      }
+
+      progress |= nir_progress(impl_progress, impl,
+                               nir_metadata_control_flow);
+   }
+
+   return progress;
+}
+
 void
 nak_postprocess_nir(nir_shader *nir,
                     const struct nak_compiler *nak,
@@ -1237,6 +1441,13 @@
    OPT(nir, nir_lower_mem_access_bit_sizes, &mem_bit_size_options);
    OPT(nir, nir_lower_bit_size, lower_bit_size_cb, (void *)nak);
 
+   if (nak->sm < 70 && nak_has_f16v2_alu(nak)) {
+      if (OPT(nir, nak_nir_pair_f16_alu)) {
+         OPT(nir, nir_opt_copy_prop);
+         OPT(nir, nir_opt_dce);
+      }
+   }
+
    OPT(nir, nir_opt_combine_barriers, NULL, NULL);
 
    OPT(nir, nir_convert_to_lcssa, true, true);
