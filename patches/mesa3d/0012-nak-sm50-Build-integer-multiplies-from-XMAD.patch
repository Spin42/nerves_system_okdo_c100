+/* Fold a 16-bit iadd of a single-use 16-bit imul into an imad, which is one
+ * XMAD on SM50-SM62.  NIR only forms imad for 32-bit values.
+ */
+static bool
+fuse_imad16(nir_builder *b, nir_alu_instr *alu, void *data)
+{
+   if (alu->op != nir_op_iadd || alu->def.bit_size != 16 ||
+       alu->def.num_components != 1)
+      return false;
+
+   for (unsigned s = 0; s < 2; s++) {
+      nir_instr *parent = nir_def_instr(alu->src[s].src.ssa);
+      if (parent->type != nir_instr_type_alu)
+         continue;
+
+      nir_alu_instr *mul = nir_instr_as_alu(parent);
+      if (mul->op != nir_op_imul || mul->def.num_components != 1 ||
+          !list_is_singular(&mul->def.uses))
+         continue;
+
+      b->cursor = nir_before_instr(&alu->instr);
+      nir_def *r = nir_imad(b, nir_ssa_for_alu_src(b, mul, 0),
+                            nir_ssa_for_alu_src(b, mul, 1),
+                            nir_ssa_for_alu_src(b, alu, 1 - s));
+      nir_def_replace(&alu->def, r);
+      nir_instr_remove(&mul->instr);
+      return true;
+   }
+
+   return false;
+}
