+#[derive(Clone, Copy, Eq, PartialEq)]
+pub enum XmadCMode {
+    /// c
+    C,
+    /// c & 0xffff
+    Clo,
+    /// c >> 16
+    Chi,
+    /// c + (b << 16), with b the full 32-bit source b
+    Cbcc,
+}
+
+/// 16x16-bit integer multiply-add, only used on SM50-SM62
+///
+/// dst = a.lo|hi * b.lo|hi (shifted left by 16 with psl) + c, with mrg
+/// replacing the high 16 bits of the result by the low 16 bits of b.
+#[repr(C)]
+#[derive(SrcsAsSlice, DstsAsSlice)]
+pub struct OpXmad {
+    #[dst_type(GPR)]
+    pub dst: Dst,
+
+    #[src_type(ALU)]
+    pub srcs: [Src; 3],
+
+    pub a_hi: bool,
+    pub b_hi: bool,
+    pub psl: bool,
+    pub mrg: bool,
+    pub c_mode: XmadCMode,
+}
+
+impl DisplayOp for OpXmad {
+    fn fmt_op(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "xmad")?;
+        if self.psl {
+            write!(f, ".psl")?;
+        }
+        if self.mrg {
+            write!(f, ".mrg")?;
+        }
+        match self.c_mode {
+            XmadCMode::C => (),
+            XmadCMode::Clo => write!(f, ".clo")?,
+            XmadCMode::Chi => write!(f, ".chi")?,
+            XmadCMode::Cbcc => write!(f, ".cbcc")?,
+        }
+        let hi = |h| if h { ".h1" } else { "" };
+        write!(
+            f,
+            " {}{} {}{} {}",
+            self.srcs[0],
+            hi(self.a_hi),
+            self.srcs[1],
+            hi(self.b_hi),
+            self.srcs[2]
+        )
+    }
+}
+impl_display_for_op!(OpXmad);
