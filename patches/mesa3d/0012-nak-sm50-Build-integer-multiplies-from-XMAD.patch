+    /// Full 64-bit product of two 32-bit values from four XMADs on SM50-SM62.
+    ///
+    /// With x = xh * 2^16 + xl and y = yh * 2^16 + yl:
+    ///
+    ///    t0 = xl * yl
+    ///    t2 = xh * yl + (t0 >> 16)
+    ///    t1 = xl * yh + (t2 & 0xffff)
+    ///    x * y = t0.lo + 2^16 * t1.lo + 2^32 * (xh * yh + t2.hi + t1.hi)
+    ///
+    /// None of the partial sums overflow 32 bits.
+    fn umul_2x32_64_xmad(&mut self, x: Src, y: Src) -> [SSAValue; 2] {
+        let xmad = |b: &mut Self, srcs: [Src; 3], a_hi, b_hi, c_mode| {
+            let dst = b.alloc_ssa(RegFile::GPR);
+            b.push_op(OpXmad {
+                dst: dst.into(),
+                srcs,
+                a_hi,
+                b_hi,
+                psl: false,
+                mrg: false,
+                c_mode,
+            });
+            dst
+        };
+        let t0 = xmad(self, [x.clone(), y.clone(), 0.into()], false, false, XmadCMode::C);
+        let t2 = xmad(self, [x.clone(), y.clone(), t0.into()], true, false, XmadCMode::Chi);
+        let t1 = xmad(self, [x.clone(), y.clone(), t2.into()], false, true, XmadCMode::Clo);
+        let h0 = xmad(self, [x, y, t2.into()], true, true, XmadCMode::Chi);
+        let lo = self.prmt(t0.into(), t1.into(), [0, 1, 4, 5]);
+        let t1_hi = self.prmt(t1.into(), 0.into(), [2, 3, 4, 4]);
+        let hi = self.iadd(h0.into(), t1_hi.into(), 0.into());
+        [lo, hi]
+    }
+
     fn imul_2x32_64(&mut self, x: Src, y: Src, signed: bool) -> SSARef {
+        if self.sm() >= 50 && self.sm() < 70 {
+            let [lo, hi] = self.umul_2x32_64_xmad(x.clone(), y.clone());
+            if !signed {
+                return [lo, hi].into();
+            }
+            // As signed values, x * y = unsigned x * y - 2^32 * ((x < 0 ? y
+            // : 0) + (y < 0 ? x : 0)) modulo 2^64.
+            let x_neg = self.isetp(IntCmpType::I32, IntCmpOp::Lt, x.clone(), 0.into());
+            let y_neg = self.isetp(IntCmpType::I32, IntCmpOp::Lt, y.clone(), 0.into());
+            let fx = self.sel(x_neg.into(), y.clone(), 0.into());
+            let fy = self.sel(y_neg.into(), x, 0.into());
+            let hi = self.iadd(hi.into(), Src::from(fx).ineg(), 0.into());
+            let hi = self.iadd(hi.into(), Src::from(fy).ineg(), 0.into());
+            return [lo, hi].into();
+        }
+
         let dst = self.alloc_ssa_vec(RegFile::GPR, 2);
         if self.sm() >= 70 {
             self.push_op(OpIMad64 {
