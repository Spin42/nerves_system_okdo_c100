+impl SM50Op for OpXmad {
+    fn legalize(&mut self, b: &mut LegalizeBuilder) {
+        use RegFile::GPR;
+        let [src0, src1, src2] = &mut self.srcs;
+        b.copy_alu_src_if_not_reg(src0, GPR, SrcType::ALU);
+        b.copy_alu_src_if_not_reg(src1, GPR, SrcType::ALU);
+        b.copy_alu_src_if_not_reg(src2, GPR, SrcType::ALU);
+    }
+
+    fn encode(&self, e: &mut SM50Encoder<'_>) {
+        assert!(self.srcs.iter().all(|s| s.is_unmodified()));
+
+        e.set_opcode(0x5b00);
+        e.set_dst(&self.dst);
+        e.set_reg_src(8..16, &self.srcs[0]);
+        e.set_reg_src(20..28, &self.srcs[1]);
+        e.set_reg_src(39..47, &self.srcs[2]);
+
+        e.set_bit(35, self.b_hi);
+        e.set_bit(36, self.psl);
+        e.set_bit(37, self.mrg);
+        e.set_bit(38, false); // .X
+        e.set_bit(47, false); // .CC
+        e.set_bit(48, false); // a signed
+        e.set_bit(49, false); // b signed
+        e.set_field(
+            50..53,
+            match self.c_mode {
+                XmadCMode::C => 0_u8,
+                XmadCMode::Clo => 1_u8,
+                XmadCMode::Chi => 2_u8,
+                XmadCMode::Cbcc => 4_u8,
+            },
+        );
+        e.set_bit(53, self.a_hi);
+    }
+}
