+    /// Low 32 bits of x * y + z from three full-rate XMADs, for SM50-SM62
+    /// where IMUL and IMAD are slow variable-latency ops
+    fn imad_xmad(&mut self, x: Src, y: Src, z: Src) -> SSAValue {
+        // x.lo * y.lo + z
+        let lo = self.alloc_ssa(RegFile::GPR);
+        self.push_op(OpXmad {
+            dst: lo.into(),
+            srcs: [x.clone(), y.clone(), z],
+            a_hi: false,
+            b_hi: false,
+            psl: false,
+            mrg: false,
+            c_mode: XmadCMode::C,
+        });
+        // (x.lo * y.hi) & 0xffff | y.lo << 16
+        let mid = self.alloc_ssa(RegFile::GPR);
+        self.push_op(OpXmad {
+            dst: mid.into(),
+            srcs: [x.clone(), y, 0.into()],
+            a_hi: false,
+            b_hi: true,
+            psl: false,
+            mrg: true,
+            c_mode: XmadCMode::C,
+        });
+        // (x.hi * y.lo) << 16 + lo + ((x.lo * y.hi) << 16)
+        let dst = self.alloc_ssa(RegFile::GPR);
+        self.push_op(OpXmad {
+            dst: dst.into(),
+            srcs: [x, mid.into(), lo.into()],
+            a_hi: true,
+            b_hi: true,
+            psl: true,
+            mrg: false,
+            c_mode: XmadCMode::Cbcc,
+        });
+        dst
+    }
+
+    /// x * y + z on 16-bit values, which only need the low halves
