# Applied on top of p3450-0000_defconfig

# The C100 module has no SPI flash. The environment holds the Nerves A/B state
# and lives on the boot medium at the offset and size used in fwup_include.
# The board code picks the microSD card when it holds a valid environment and
# the eMMC otherwise.
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_ENV_MMC_EMMC_HW_PARTITION=0
CONFIG_ENV_OFFSET=0x200000
CONFIG_ENV_SIZE=0x20000

# The kernel and device tree are loaded from the squashfs root filesystems
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_SQUASHFS=y
CONFIG_CMD_PART=y

# Only used when no Nerves environment exists on either device. Distro boot
# would find this U-Boot's own chain-loading script on the microSD card.
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="echo No Nerves U-Boot environment on the microSD card or the eMMC"

# U-Boot lives in the 64 MiB LNX eMMC partition or on the microSD card, not in
# the 768 KiB SPI flash region that this limit protects on the developer kit.
# CONFIG_HAS_BOARD_SIZE_LIMIT is not set

CONFIG_BOOTDELAY=1
